# Server Configuration
PORT=3000
NODE_ENV=development

# Public Base URL for Twilio Webhooks (Use your ngrok or deployed URL when testing live telephony)
# Example: https://abc1234.ngrok-free.app
BASE_URL=http://localhost:3000

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Gemini LLM Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & Demo Number Override (Safety Guardrail)
# When set, any outbound call will be directed to this phone number you control/verified,
# preventing accidental calls to fictional numbers while preserving customer persona context.
AUTHORIZED_TEST_PHONE_NUMBER=+91XXXXXXXXXX
